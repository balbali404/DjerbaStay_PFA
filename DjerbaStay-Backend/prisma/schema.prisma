generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionCode {
  FREE
  PLUS
  PREMIUM
}

enum TransportMode {
  taxi
  car_rental
  bus
}

enum Role {
  CLIENT
  HOTEL_ADMIN
  SUPER_ADMIN
}

enum HotelStatus {
  ACTIVE
  INACTIVE
}

model SubscriptionPlan {
  id                String           @id @default(cuid())
  code              SubscriptionCode @unique
  name              String
  description       String
  monthlyMlRequests Int?
  monthlyPriceUsd   Float
  features          Json?
  users             User[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model User {
  id              String           @id @default(cuid())
  fullName        String
  email           String           @unique
  passwordHash    String
  language        String           @default("en")
  role            Role             @default(CLIENT)
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  refreshTokens   RefreshToken[]
  monthlyUsages   MonthlyUsage[]
  plannerRequests PlannerRequest[]
  managedHotels   Accommodation[]  @relation("HotelAdmin")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MonthlyUsage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthStart DateTime
  mlRequests Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, monthStart])
  @@index([monthStart])
}

model Accommodation {
  id              String              @id @default(cuid())
  externalId      Int                 @unique
  name            String
  type            String?
  area            String?
  imageFileName   String?
  latitude        Float
  longitude       Float
  rating          Float?
  priceEuro       Float?
  status          HotelStatus         @default(ACTIVE)
  adminUserId     String?
  adminUser       User?               @relation("HotelAdmin", fields: [adminUserId], references: [id])
  plannerRequests PlannerRequest[]
  availabilities  HotelAvailability[]
  guides          HotelGuide[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([adminUserId])
}

model HotelAvailability {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([accommodationId])
  @@index([startDate, endDate])
}

model HotelGuide {
  id              String        @id @default(cuid())
  accommodationId String
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  name            String
  specialty       String?
  phone           String?
  isAvailable     Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([accommodationId])
}

model Place {
  id            String   @id @default(cuid())
  externalId    Int      @unique
  name          String
  type          String
  category      String
  imageFileName String?
  latitude      Float
  longitude     Float
  rating        Float?
  durationHours Float
  price         Float?
  tags          String
  travelType    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Restaurant {
  id            String   @id @default(cuid())
  externalId    Int      @unique
  name          String
  imageFileName String?
  latitude      Float
  longitude     Float
  rating        Float?
  price         Float?
  tags          String
  travelType    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TravelerProfile {
  id            String   @id @default(cuid())
  personality   String   @unique
  keywords      String
  imageFileName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Synonym {
  id        String   @id @default(cuid())
  term      String   @unique
  expansion String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TripBudgetSample {
  id              String        @id @default(cuid())
  externalRowId   Int           @unique
  days            Int
  persons         Int
  budgetLevel     Int
  transport       TransportMode
  totalActivities Float
  totalFood       Float
  totalTransport  Float
  totalCost       Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum ReservationApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model PlannerRequest {
  id                      String                      @id @default(cuid())
  userId                  String
  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accommodationId         String
  accommodation           Accommodation               @relation(fields: [accommodationId], references: [id])
  interests               String
  days                    Int
  persons                 Int
  budgetLevel             Int
  transport               TransportMode
  travelStartDate         DateTime?
  tripPlan                Json
  budgetBreakdown         Json
  flaskPlanStatus         Int
  flaskBudgetStatus       Int
  approvalStatus          ReservationApprovalStatus   @default(PENDING)
  approvalNotes           String?
  approvedAt              DateTime?
  rejectedAt              DateTime?
  invoiceUrl              String?
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@index([userId, createdAt])
  @@index([accommodationId])
  @@index([approvalStatus])
}
